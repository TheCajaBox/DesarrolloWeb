{
  "name": "el-sombrero-de-wayne",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Taller para aprender a construir una web desde 0, con Wayne y Wax de guias",
  "main": "taller-escritorio/main.cjs",
  "scripts": {
    "dev:publico": "vite --config vite.publico.js",
    "dev:taller": "vite --config vite.taller.js",
    "build": "npm run build:publico && npm run build:taller",
    "build:publico": "vite build --config vite.publico.js",
    "build:taller": "vite build --config vite.taller.js",
    "servidor:publico": "wrangler dev -c wrangler.publico.jsonc",
    "servidor:taller": "wrangler dev -c wrangler.taller.jsonc",
    "publicar:publico": "npm run build:publico && wrangler deploy -c wrangler.publico.jsonc",
    "publicar:taller": "npm run build:taller && wrangler deploy -c wrangler.taller.jsonc",
    "bbdd:local": "wrangler d1 migrations apply sombreros --local -c wrangler.publico.jsonc",
    "bbdd:remota": "wrangler d1 migrations apply sombreros --remote -c wrangler.publico.jsonc",
    "test": "vitest run",
    "test:mirar": "vitest",
    "escritorio": "electron taller-escritorio/main.cjs",
    "dev:escritorio": "vite --config vite.escritorio.js",
    "build:escritorio": "vite build --config vite.escritorio.js",
    "instalador": "electron-builder --win nsis",
    "publicar": "electron-builder --win nsis --publish always",
    "humo": "node herramientas/prueba-de-humo.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.2",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.4",
    "monaco-editor": "^0.56.0",
    "npm": "^12.0.2",
    "pinia": "^4.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "build": {
    "appId": "com.sombrero.wayne",
    "productName": "El Sombrero de Wayne",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "instalador"
    },
    "files": [
      "taller-escritorio/**/*",
      "src/**/*",
      "paginas/escritorio/**/*",
      "vite.escritorio.js",
      "package.json",
      "!taller-escritorio/proyecto-alumna/node_modules",
      "!taller-escritorio/proyecto-alumna/dist",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheCajaBox",
        "repo": "DesarrolloWeb"
      }
    ],
    "artifactName": "el-sombrero-de-wayne-${version}.${ext}"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}
